<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <!-- =============================================================== -->
    <!-- Project hierarchy -->
    <!-- =============================================================== -->
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.github.jjabakker</groupId>
        <artifactId>paint-parent</artifactId>
        <version>0.0.58-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>
    <artifactId>paint-generate-squares</artifactId>
    <packaging>jar</packaging>

    <!-- =============================================================== -->
    <!-- Metadata -->
    <!-- =============================================================== -->
    <name>Paint Generate Squares</name>
    <description>Standalone desktop application for generating experiment squares</description>

    <!-- =============================================================== -->
    <!-- Application properties -->
    <!-- =============================================================== -->
    <properties>
        <project.build.outputTimestamp>2025-11-04T09:30:36Z</project.build.outputTimestamp>
        <app.name>Generate Squares</app.name>
        <app.bundle>${project.build.directory}/${app.name}.app</app.bundle>
        <app.icon.macos>${project.basedir}/src/main/resources/icons/paint-generate-squares.icns</app.icon.macos>
        <app.icon.windows>${project.basedir}/src/main/resources/icons/paint-generate-squares.ico</app.icon.windows>
        <fat.jar>${project.build.directory}/${project.build.finalName}-jar-with-dependencies.jar</fat.jar>
    </properties>

    <!-- =============================================================== -->
    <!-- Dependencies -->
    <!-- =============================================================== -->
    <dependencies>

        <!-- Shared internal utilities -->
        <dependency>
            <groupId>com.github.jjabakker</groupId>
            <artifactId>paint-shared-utils</artifactId>
            <version>0.0.58-SNAPSHOT</version>
        </dependency>

        <!-- ImageJ and Fiji components -->
        <dependency>
            <groupId>net.imagej</groupId>
            <artifactId>ij</artifactId>
            <version>1.54h</version>
        </dependency>

        <dependency>
            <groupId>sc.fiji</groupId>
            <artifactId>TrackMate</artifactId>
            <version>7.14.0</version>
        </dependency>

        <dependency>
            <groupId>sc.fiji</groupId>
            <artifactId>fiji-lib</artifactId>
            <version>2.1.3</version>
        </dependency>

        <dependency>
            <groupId>net.imglib2</groupId>
            <artifactId>imglib2</artifactId>
            <version>7.1.5</version>
        </dependency>

        <!-- Logging -->
        <dependency>
            <groupId>ch.qos.logback</groupId>
            <artifactId>logback-classic</artifactId>
            <version>1.2.13</version>
        </dependency>

        <!-- Bio-Formats -->
        <dependency>
            <groupId>ome</groupId>
            <artifactId>bio-formats_plugins</artifactId>
            <version>6.13.0</version>
        </dependency>

        <dependency>
            <groupId>ome</groupId>
            <artifactId>formats-gpl</artifactId>
            <version>6.13.0</version>
        </dependency>

        <dependency>
            <groupId>ome</groupId>
            <artifactId>formats-api</artifactId>
            <version>6.13.0</version>
        </dependency>

        <!-- Data and CSV handling -->
        <dependency>
            <groupId>tech.tablesaw</groupId>
            <artifactId>tablesaw-core</artifactId>
            <version>0.43.1</version>
        </dependency>

        <dependency>
            <groupId>com.opencsv</groupId>
            <artifactId>opencsv</artifactId>
            <version>5.9</version>
        </dependency>

        <dependency>
            <groupId>com.google.code.gson</groupId>
            <artifactId>gson</artifactId>
            <version>2.11.0</version>
        </dependency>

    </dependencies>

    <!-- =============================================================== -->
    <!-- Build configuration -->
    <!-- =============================================================== -->
    <build>
        <plugins>

            <!-- Include version and build info in the manifest for PAINT Logger -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.3.0</version>
                <configuration>
                    <archive>
                        <manifest>
                            <mainClass>paint.generatesquares.GenerateSquares</mainClass>
                        </manifest>
                        <manifestEntries>
                            <Implementation-Title>${project.name}</Implementation-Title>
                            <Implementation-Version>${project.version}</Implementation-Version>
                            <Implementation-Vendor>Glyco-PAINT</Implementation-Vendor>
                            <Build-Timestamp>${maven.build.timestamp}</Build-Timestamp>
                            <Build-Jdk>${java.version}</Build-Jdk>
                            <Built-By>${user.name}</Built-By>
                        </manifestEntries>
                    </archive>
                </configuration>
            </plugin>

            <!-- Fat JAR assembly -->
            <!-- Create fat JAR with embedded manifest and dependencies -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.5.3</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <finalName>${project.artifactId}-${project.version}-jar-with-dependencies</finalName>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>paint.generatesquares.GenerateSquares</mainClass>
                                    <manifestEntries>
                                        <Implementation-Title>${project.name}</Implementation-Title>
                                        <Implementation-Version>${project.version}</Implementation-Version>
                                        <Implementation-Vendor>Glyco-PAINT</Implementation-Vendor>
                                        <Specification-Title>${project.name}</Specification-Title>
                                        <Specification-Version>${project.version}</Specification-Version>
                                        <Specification-Vendor>Glyco-PAINT</Specification-Vendor>
                                        <Built-By>${user.name}</Built-By>
                                        <Build-Jdk>${java.version}</Build-Jdk>
                                        <Build-Timestamp>${maven.build.timestamp}</Build-Timestamp>
                                    </manifestEntries>
                                </transformer>
                            </transformers>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <!-- =============================================================== -->
    <!-- OS-specific build profiles -->
    <!-- =============================================================== -->
    <profiles>

        <!-- macOS .app bundle profile -->
        <profile>
            <id>macos-appbundle</id>
            <activation>
                <os>
                    <family>mac</family>
                </os>
            </activation>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-antrun-plugin</artifactId>
                        <version>3.1.0</version>
                        <executions>
                            <execution>
                                <id>create-app-bundle</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>run</goal>
                                </goals>
                                <configuration>
                                    <target>
                                        <echo message="Creating macOS .app bundle at ${app.bundle}"/>
                                        <delete dir="${app.bundle}" failonerror="false"/>
                                        <delete failonerror="false" file="${project.build.directory}/${app.name}.app.zip"/>
                                        <mkdir dir="${app.bundle}/Contents/MacOS"/>
                                        <mkdir dir="${app.bundle}/Contents/Java"/>
                                        <mkdir dir="${app.bundle}/Contents/Resources"/>

                                        <!-- Copy app files -->
                                        <copy failonerror="false" file="${fat.jar}" overwrite="true" todir="${app.bundle}/Contents/Java"/>
                                        <copy failonerror="false" file="${app.icon.macos}" overwrite="true" todir="${app.bundle}/Contents/Resources"/>

                                        <!-- Create Info.plist -->
                                        <echo file="${app.bundle}/Contents/Info.plist"></echo>

                                        <!-- Create launch script -->
                                        <echo file="${app.bundle}/Contents/MacOS/launch"></echo>
                                        <fixcrlf eol="unix" file="${app.bundle}/Contents/MacOS/launch"/>
                                        <chmod file="${app.bundle}/Contents/MacOS/launch" perm="755"/>

                                        <!-- Zip and install -->
                                        <exec executable="zip">
                                            <arg value="-r"/>
                                            <arg value="${project.build.directory}/${app.name}.app.zip"/>
                                            <arg value="${app.bundle}"/>
                                        </exec>
                                        <mkdir dir="${user.home}/Applications/Glyco-PAINT"/>
                                        <delete dir="${user.home}/Applications/Glyco-PAINT/${app.name}.app" quiet="true"/>
                                        <copy failonerror="false" overwrite="true" todir="${user.home}/Applications/Glyco-PAINT">
                                            <fileset dir="${project.build.directory}">
                                                <include name="${app.name}.app/**"/>
                                            </fileset>
                                        </copy>
                                        <exec executable="chmod" failonerror="false">
                                            <arg value="755"/>
                                            <arg value="${user.home}/Applications/Glyco-PAINT/${app.name}.app/Contents/MacOS/launch"/>
                                        </exec>
                                        <echo message="Installed to ~/Applications/Glyco-PAINT/${app.name}.app"/>
                                    </target>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <!-- Windows .exe launcher profile -->
        <profile>
            <id>windows-exe</id>
            <activation>
                <os>
                    <family>windows</family>
                </os>
            </activation>
            <build>
                <plugins>
                    <plugin>
                        <groupId>com.akathist.maven.plugins.launch4j</groupId>
                        <artifactId>launch4j-maven-plugin</artifactId>
                        <version>2.5.0</version>
                        <executions>
                            <execution>
                                <id>l4j-generate-squares</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>launch4j</goal>
                                </goals>
                                <configuration>
                                    <outfile>${project.build.directory}/${app.name}.exe</outfile>
                                    <jar>${fat.jar}</jar>
                                    <dontWrapJar>false</dontWrapJar>
                                    <icon>${project.basedir}/src/main/resources/icons/${project.artifactId}.ico</icon>
                                    <jre>
                                        <minVersion>1.8.0</minVersion>
                                    </jre>
                                    <classPath>
                                        <mainClass>paint.generatesquares.GenerateSquares</mainClass>
                                    </classPath>
                                    <headerType>gui</headerType>
                                    <errTitle>${app.name}</errTitle>
                                    <versionInfo>
                                        <fileVersion>1.0.0.0</fileVersion>
                                        <txtFileVersion>${project.version}</txtFileVersion>
                                        <productVersion>1.0.0.0</productVersion>
                                        <txtProductVersion>${project.version}</txtProductVersion>
                                        <fileDescription>${project.description}</fileDescription>
                                        <productName>${app.name}</productName>
                                        <companyName>Glyco-PAINT</companyName>
                                    </versionInfo>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

    <!-- =============================================================== -->
    <!-- External repositories -->
    <!-- =============================================================== -->
    <repositories>
        <repository>
            <id>scijava.public</id>
            <url>https://maven.scijava.org/content/groups/public</url>
        </repository>

        <repository>
            <id>ome.releases</id>
            <url>https://artifacts.openmicroscopy.org/artifactory/maven/</url>
        </repository>

    </repositories>
    <version>0.0.58-SNAPSHOT</version>
</project>
