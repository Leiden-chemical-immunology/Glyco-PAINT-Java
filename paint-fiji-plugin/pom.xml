<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.github.jjabakker</groupId>
        <artifactId>paint-parent</artifactId>
        <version>0.0.141-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>
    <artifactId>paint-fiji-plugin</artifactId>
    <packaging>jar</packaging>
    <name>Fiji Plugin</name>
    <description>Integration of Paint application with Fiji/TrackMate plugin</description>
    <properties>
        <maven.build.timestamp.format>yyyy-MM-dd HH:mm:ss</maven.build.timestamp.format>
    </properties>
    <dependencies>

        <!-- Fiji / TrackMate APIs (provided by Fiji runtime) -->
        <dependency>
            <groupId>sc.fiji</groupId>
            <artifactId>TrackMate</artifactId>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>org.scijava</groupId>
            <artifactId>scijava-common</artifactId>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>org.openmicroscopy</groupId>
            <artifactId>ome-common</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- Internal shared module -->
        <dependency>
            <groupId>com.github.jjabakker</groupId>
            <artifactId>paint-shared-utils</artifactId>
        </dependency>

        <!-- Unit testing (JUnit 5; version managed by parent POM) -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- The comparison engine, for the TrackMate regression gate (test only) -->
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>paint-compare</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>

        <!-- Shared Swing UI (console window, project dialog). This module shows a user
             interface, so it depends on the UI layer; headless consumers must not. -->
        <dependency>
            <groupId>com.github.jjabakker</groupId>
            <artifactId>paint-ui-common</artifactId>
        </dependency>

        <!-- ImageJ 1.x. This module imports ij.IJ, ij.ImagePlus and ij.io.FileSaver directly.
             It used to arrive transitively (partly via paint-generate-squares, which no longer
             carries the imaging stack), so declare what we actually use. -->
        <dependency>
            <groupId>net.imagej</groupId>
            <artifactId>ij</artifactId>
        </dependency>

        <!-- Bundled dependencies -->
        <dependency>
            <groupId>tech.tablesaw</groupId>
            <artifactId>tablesaw-core</artifactId>
        </dependency>

        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-csv</artifactId>
        </dependency>

        <dependency>
            <groupId>it.unimi.dsi</groupId>
            <artifactId>fastutil</artifactId>
        </dependency>

        <dependency>
            <groupId>com.univocity</groupId>
            <artifactId>univocity-parsers</artifactId>
        </dependency>

        <dependency>
            <groupId>com.github.jjabakker</groupId>
            <artifactId>paint-generate-squares</artifactId>
            <scope>compile</scope>
        </dependency>

    </dependencies>
    <repositories>
        <repository>
            <id>scijava.public</id>
            <url>https://maven.scijava.org/content/groups/public</url>
        </repository>

    </repositories>
    <build>
        <plugins>

            <!-- Java level (release) comes from the parent POM -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.11.0</version>
                <configuration>
                    <compilerArgs>
                        <arg>-Xlint:-options</arg>
                    </compilerArgs>
                    <!-- Generates META-INF/json/org.scijava.plugin.Plugin, the index Fiji uses to
                         find the @Plugin commands. Named explicitly because javac (JDK 23+) no
                         longer runs processors found on the classpath. -->
                    <annotationProcessors>
                        <annotationProcessor>org.scijava.annotations.AnnotationProcessor</annotationProcessor>
                    </annotationProcessors>
                </configuration>
            </plugin>

            <!-- Inject manifest metadata (Compilation-Data) -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.3.0</version>
                <configuration>
                    <archive>
                        <manifest>
                            <addDefaultImplementationEntries>true</addDefaultImplementationEntries>
                            <addDefaultSpecificationEntries>true</addDefaultSpecificationEntries>
                        </manifest>
                        <manifestEntries>
                            <Built-By>${user.name}</Built-By>
                            <Build-Jdk>${java.version}</Build-Jdk>
                            <Build-Timestamp>${maven.build.timestamp}</Build-Timestamp>
                        </manifestEntries>
                    </archive>
                </configuration>
            </plugin>

            <!-- Shade all dependencies into one JAR -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.5.3</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <finalName>${project.artifactId}-${project.version}-jar-with-dependencies</finalName>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <manifestEntries>
                                        <Implementation-Title>${project.name}</Implementation-Title>
                                        <Implementation-Version>${project.version}</Implementation-Version>
                                        <Implementation-Vendor>${project.organization.name}</Implementation-Vendor>
                                        <Specification-Title>${project.name}</Specification-Title>
                                        <Specification-Version>${project.version}</Specification-Version>
                                        <Specification-Vendor>${project.organization.name}</Specification-Vendor>
                                        <Built-By>${user.name}</Built-By>
                                        <Build-Jdk>${java.version}</Build-Jdk>
                                        <Build-Timestamp>${maven.build.timestamp}</Build-Timestamp>
                                    </manifestEntries>
                                </transformer>
                                <!-- Merge duplicated java.util.ServiceLoader files instead of dropping all but one. -->
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                                <!-- Concatenate the legal-notice text files that every bundled jar ships,
                                     silencing the harmless "overlapping resource" warnings for these. -->
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ApacheNoticeResourceTransformer"/>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ApacheLicenseResourceTransformer"/>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.AppendingTransformer">
                                    <resource>META-INF/DEPENDENCIES</resource>
                                </transformer>
                            </transformers>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!--
                Cleanup and copy JAR into Fiji (skip automatically on CI).

                The Fiji folder is the first of these that contains a "plugins" folder, the same
                places the installers search:
                  Windows: %ProgramFiles%, %ProgramFiles(x86)%, %LOCALAPPDATA%, each with
                           Fiji, Fiji-win64, Fiji-win32, Fiji-Windows
                  macOS:   ~/Applications and /Applications, each with Fiji.app and Fiji
                           (Fiji Latest unpacks to "Fiji")
                Override with -Dfiji.dir=<folder>; the build then fails if that folder has no
                "plugins" folder. If no Fiji is found, the copy is skipped with a warning.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <version>3.1.0</version>
                <executions>
                    <execution>
                        <id>deploy-to-fiji</id>
                        <phase>install</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>

                            <!-- ✅ Skip deployment automatically on CI -->
                            <skip>${env.CI}</skip>
                            <target xmlns:if="ant:if" xmlns:unless="ant:unless">
                                <!-- "sysenv", not "env": Maven would interpolate ${env.*} itself -->
                                <property environment="sysenv"/>

                                <condition property="fiji.dir.explicit">
                                    <isset property="fiji.dir"/>
                                </condition>
                                <fail message="-Dfiji.dir=${fiji.dir} is not a Fiji folder (it has no plugins folder)">
                                    <condition>
                                        <and>
                                            <isset property="fiji.dir.explicit"/>
                                            <not><available file="${fiji.dir}/plugins" type="dir"/></not>
                                        </and>
                                    </condition>
                                </fail>

                                <!-- Sets fiji.dir to the first candidate that has a plugins folder
                                     (an Ant property, once set, is never overwritten) -->
                                <macrodef name="try-fiji">
                                    <attribute name="dir"/>
                                    <sequential>
                                        <condition property="fiji.dir" value="@{dir}">
                                            <available file="@{dir}/plugins" type="dir"/>
                                        </condition>
                                    </sequential>
                                </macrodef>
                                <macrodef name="try-fiji-names">
                                    <attribute name="base"/>
                                    <sequential>
                                        <try-fiji dir="@{base}/Fiji"/>
                                        <try-fiji dir="@{base}/Fiji-win64"/>
                                        <try-fiji dir="@{base}/Fiji-win32"/>
                                        <try-fiji dir="@{base}/Fiji-Windows"/>
                                    </sequential>
                                </macrodef>

                                <!-- Windows -->
                                <try-fiji-names base="${sysenv.ProgramFiles}"/>
                                <try-fiji-names base="${sysenv.ProgramFiles(x86)}"/>
                                <try-fiji-names base="${sysenv.LOCALAPPDATA}"/>
                                <!-- macOS -->
                                <try-fiji dir="${user.home}/Applications/Fiji.app"/>
                                <try-fiji dir="${user.home}/Applications/Fiji"/>
                                <try-fiji dir="/Applications/Fiji.app"/>
                                <try-fiji dir="/Applications/Fiji"/>

                                <echo unless:set="fiji.dir" level="warning"
                                      message="⚠️ No Fiji folder found; the plugin was NOT copied into Fiji. Use -Dfiji.dir=&lt;folder&gt; to name it."/>

                                <echo if:set="fiji.dir" message="🚀 Deploying ${project.artifactId} to ${fiji.dir}"/>
                                <delete if:set="fiji.dir" quiet="true">
                                    <fileset dir="${fiji.dir}/plugins">
                                        <include name="paint*.jar"/>
                                    </fileset>
                                </delete>
                                <copy if:set="fiji.dir" overwrite="true" todir="${fiji.dir}/plugins">
                                    <fileset dir="${project.build.directory}">
                                        <include name="${project.artifactId}-${project.version}-jar-with-dependencies.jar"/>
                                    </fileset>
                                </copy>
                                <echo if:set="fiji.dir" message="✅ Deployed ${project.artifactId} fat JAR to ${fiji.dir}/plugins/"/>
                            </target>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
