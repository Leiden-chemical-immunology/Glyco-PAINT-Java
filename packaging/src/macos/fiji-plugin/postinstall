#!/bin/bash
#
# The "Fiji plugin" choice of the Glyco-PAINT installer for macOS. The component installs the
# plugin JAR in /Library/Application Support/Glyco-PAINT; this script then copies it into the
# plugins folder of the user's Fiji.
#
# Fiji is looked for in /Applications and ~/Applications, as Fiji.app or Fiji (the folder name of
# a Fiji Latest download), and must have a plugins folder. If none is found there, the user is
# asked for the Fiji folder. An older Glyco-PAINT plugin in Fiji is replaced. The apps are
# installed regardless. The outcome is written to $result_file for the installer's summary
# (summary/postinstall), which tells the user where the plugin went, or that it was not installed.
# Everything this script does is written to the installer log (Window > Installer Log).
#
# The installer runs this as root.

log() { echo "Glyco-PAINT: $*"; }

plugin_dir="/Library/Application Support/Glyco-PAINT"
result_file="$plugin_dir/fiji-plugin-result.txt"
plugin=$(ls "$plugin_dir"/paint-fiji-plugin*.jar 2>/dev/null | head -n 1)
if [ -z "$plugin" ]; then
    log "no Fiji plugin JAR in the installer; nothing to copy"
    echo "NONE" > "$result_file"
    exit 0
fi

# The logged-in user, whose ~/Applications is searched and who gets the warning
user=$(stat -f %Su /dev/console)
uid=$(id -u "$user")
home=$(dscl . -read "/Users/$user" NFSHomeDirectory 2>/dev/null | awk '{print $2}')

fiji=""
for candidate in "/Applications/Fiji.app" "/Applications/Fiji" "$home/Applications/Fiji.app" "$home/Applications/Fiji"; do
    if [ -d "$candidate/plugins" ]; then
        fiji="$candidate"
        break
    fi
done

# Runs an AppleScript as the logged-in user (the installer runs this script as root)
as_user() {
    launchctl asuser "$uid" sudo -u "$user" osascript -e "$1" 2>/dev/null
}

# The Fiji folder in or at the chosen folder: itself, or a Fiji.app or Fiji inside it
fiji_at() {
    local dir="${1%/}" candidate
    for candidate in "$dir" "$dir/Fiji.app" "$dir/Fiji"; do
        if [ -d "$candidate/plugins" ]; then
            echo "$candidate"
            return
        fi
    done
}

# Not in the usual places: ask, until a Fiji folder is chosen or the user cancels
if [ -z "$fiji" ]; then
    log "no Fiji found in /Applications or $home/Applications; asking the user"
    prompt="No Fiji was found in /Applications or in your own Applications folder. Choose your Fiji folder (the one with the plugins folder), or Cancel to skip the Fiji plugin."
    while [ -z "$fiji" ]; do
        chosen=$(as_user "POSIX path of (choose folder with prompt \"$prompt\" default location (path to home folder))") || break
        fiji=$(fiji_at "$chosen")
        if [ -z "$fiji" ]; then
            log "$chosen is not a Fiji folder (no plugins folder)"
            prompt="$chosen is not a Fiji folder: it has no plugins folder. Choose your Fiji folder, or Cancel to skip the Fiji plugin."
        fi
    done
fi

if [ -z "$fiji" ]; then
    log "no Fiji chosen; the plugin was not installed"
    echo "NONE" > "$result_file"
    exit 0
fi

rm -f "$fiji"/plugins/paint-fiji-plugin*.jar
if cp "$plugin" "$fiji/plugins/"; then
    # Same owner as the plugins folder, so Fiji (run as the user) can manage it
    owner=$(stat -f %Su:%Sg "$fiji/plugins")
    chown "$owner" "$fiji/plugins/$(basename "$plugin")"
    log "installed $(basename "$plugin") into $fiji/plugins"
    echo "$fiji/plugins/$(basename "$plugin")" > "$result_file"
else
    log "could not copy the plugin into $fiji/plugins"
    echo "FAILED $fiji/plugins" > "$result_file"
fi

# Never fail the installation because of the plugin: the apps are installed regardless
exit 0
